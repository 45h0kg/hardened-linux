## The audit trail an investigator needs after an intrusion: who changed
## identity, privilege, policy and time; who loaded kernel code; who ran
## privileged programs; who was denied access to what.
## auid>=1000 && auid!=unset limits rules to actions traced to a human login
## (the login UID survives su and sudo), which keeps volume manageable.

## Time changes (an attacker shifts the clock to confuse log correlation)
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime,stime -k time-change
-w /etc/localtime -p wa -k time-change
-w /etc/chrony.conf -p wa -k time-change

## Identity: accounts, groups, passwords
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/subuid -p wa -k identity
-w /etc/subgid -p wa -k identity
-w /usr/sbin/useradd -p x -k identity
-w /usr/sbin/usermod -p x -k identity
-w /usr/sbin/userdel -p x -k identity
-w /usr/sbin/groupadd -p x -k identity
-w /usr/sbin/groupmod -p x -k identity
-w /usr/bin/passwd -p x -k identity

## Privilege configuration
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d/ -p wa -k privilege
-w /etc/security/ -p wa -k privilege
-w /etc/pam.d/ -p wa -k privilege
-w /etc/authselect/ -p wa -k privilege
-w /etc/login.defs -p wa -k privilege
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd

## Network identity
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/hostname -p wa -k system-locale
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/NetworkManager/ -p wa -k system-locale
-w /etc/firewalld/ -p wa -k firewall

## Mandatory access control and other security tooling
-w /etc/selinux/ -p wa -k MAC-policy
-w /usr/share/selinux/ -p wa -k MAC-policy
-w /etc/fapolicyd/ -p wa -k fapolicyd
-w /etc/usbguard/ -p wa -k usbguard
-w /etc/aide.conf -p wa -k aide
-w /etc/audit/ -p wa -k audit-config
-w /usr/sbin/auditctl -p x -k audit-tools
-w /usr/sbin/auditd -p x -k audit-tools
-w /usr/sbin/augenrules -p x -k audit-tools
-w /usr/sbin/setenforce -p x -k MAC-policy
-w /usr/sbin/setsebool -p x -k MAC-policy
-w /usr/sbin/semanage -p x -k MAC-policy
-w /usr/sbin/semodule -p x -k MAC-policy

## Logins and sessions
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock/ -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session

## Kernel modules and kexec (loading code into the kernel)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S kexec_load,kexec_file_load -k kexec
-w /usr/sbin/insmod -p x -k modules
-w /usr/sbin/rmmod -p x -k modules
-w /usr/sbin/modprobe -p x -k modules
-w /etc/modprobe.d/ -p wa -k modules

## Mounts (mounting a USB stick or a crafted image)
-a always,exit -F arch=b64 -S mount,umount2,mount_setattr,open_tree,move_mount,fsmount -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b32 -S mount,umount2 -F auid>=1000 -F auid!=unset -k mounts

## Permission and ownership changes by users
-a always,exit -F arch=b64 -S fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S fchown,fchownat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat,chown,fchown,lchown,fchownat,chown32,fchown32,lchown32 -F auid>=1000 -F auid!=unset -k perm_mod

## Failed access to files (probing)
-a always,exit -F arch=b64 -S openat,openat2,truncate,ftruncate,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S openat,openat2,truncate,ftruncate,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,creat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b32 -S open,openat,creat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access

## Deletions by users
-a always,exit -F arch=b64 -S unlinkat,renameat,renameat2 -F auid>=1000 -F auid!=unset -k delete

## Privilege use: every execve that runs as root on behalf of a human, and
## every use of setuid/setgid programs and sudo/su.
-a always,exit -F arch=b64 -S execve,execveat -C uid!=euid -F euid=0 -k setuid
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k setuid
-a always,exit -F arch=b64 -S execve,execveat -F euid=0 -F auid>=1000 -F auid!=unset -k rootcmd
-w /usr/bin/sudo -p x -k privileged
-w /usr/bin/su -p x -k privileged
-w /usr/bin/newgrp -p x -k privileged
-w /usr/bin/chsh -p x -k privileged
-w /usr/bin/chfn -p x -k privileged
-w /usr/bin/crontab -p x -k privileged
-w /usr/bin/pkexec -p x -k privileged
-w /usr/sbin/unix_chkpwd -p x -k privileged
-w /usr/bin/bootc -p x -k bootc
-w /usr/bin/rpm-ostree -p x -k bootc

## Legacy syscalls that exist only on x86_64 (aarch64 has just the *at
## forms above). Kept on separate lines because auditctl drops a whole rule
## when one syscall name in it is unknown on the running architecture.
-a always,exit -F arch=b64 -S chmod,chown,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S open,creat -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S open,creat -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S unlink,rename,rmdir -F auid>=1000 -F auid!=unset -k delete
-a always,exit -F arch=b64 -S fchmodat2 -F auid>=1000 -F auid!=unset -k perm_mod

## ptrace and other cross-process inspection (code injection)
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k code-injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k data-injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -k register-injection
-a always,exit -F arch=b64 -S process_vm_writev -k code-injection

## eBPF programs being loaded
-a always,exit -F arch=b64 -S bpf -F a0=5 -k bpf-load
