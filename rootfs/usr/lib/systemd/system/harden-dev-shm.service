# /dev/shm is mounted by systemd before units run, so it can't be given a
# mount unit; remount it with nosuid,nodev,noexec early in boot instead.
[Unit]
Description=Remount /dev/shm nosuid,nodev,noexec
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mount -o remount,nosuid,nodev,noexec /dev/shm

[Install]
WantedBy=sysinit.target
