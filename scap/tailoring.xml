<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tailoring of the DISA STIG for RHEL 10 (SCAP Security Guide, CentOS
  Stream 10 datastream). Every change here is a deliberate deviation,
  explained in scap/README.md.
-->
<xccdf:Tailoring xmlns:xccdf="http://checklists.nist.gov/xccdf/1.2" id="xccdf_hardened-linux_tailoring_stig">
  <xccdf:benchmark href="/usr/share/xml/scap/ssg/content/ssg-cs10-ds.xml"/>
  <xccdf:version time="2026-11-13T00:00:00">1</xccdf:version>
  <xccdf:Profile id="xccdf_org.ssgproject.content_profile_stig_hardened_linux" extends="xccdf_org.ssgproject.content_profile_stig">
    <xccdf:title>DISA STIG for RHEL 10, tailored for hardened-linux</xccdf:title>
    <xccdf:description>STIG with the FUTURE crypto policy instead of FIPS, and a time-limited faillock lockout.</xccdf:description>
    <!-- FIPS mode: CentOS Stream ships no FIPS-validated crypto modules, so
         fips=1 would claim a property the system does not have. FUTURE is
         used instead (stronger minimums, not validated). -->
    <xccdf:select idref="xccdf_org.ssgproject.content_rule_sysctl_crypto_fips_enabled" selected="false"/>
    <xccdf:set-value idref="xccdf_org.ssgproject.content_value_var_system_crypto_policy">FUTURE</xccdf:set-value>
    <!-- Locked accounts unlock after 15 minutes rather than never, so an
         attacker at the console cannot lock administrators out for good. -->
    <xccdf:set-value idref="xccdf_org.ssgproject.content_value_var_accounts_passwords_pam_faillock_unlock_time">900</xccdf:set-value>
  </xccdf:Profile>
</xccdf:Tailoring>
